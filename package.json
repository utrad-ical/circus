{
  "name": "root",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/utrad-ical/circus.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @utrad-ical/circus-api --filter @utrad-ical/circus-web-ui run dev",
    "test": "node --env-file-if-exists=.env --test --test-force-exit --test-concurrency=1 --test-timeout=10000 \"packages/*/src/**/*.test.ts\"",
    "build": "pnpm -r --if-present run build",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "lint-format": "oxfmt --check",
    "format": "oxfmt",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "~7.0.2"
  }
}
