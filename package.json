{
  "name": "root",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/utrad-ical/circus.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "test": "jest",
    "build": "pnpm -r --if-present run build",
    "lint": "eslint \"packages/*/{src,test}/**/*.{js,ts,tsx}\"",
    "lint-fix": "eslint --fix \"packages/*/{src,test}/**/*.{js,ts,tsx}\"",
    "lint-prettier": "prettier --check \"packages/*/{src,test}/**/*.{js,ts,less,json,yaml,yml}\"",
    "prettier": "prettier --write \"packages/*/{src,test}/**/*.{js,ts,less,json,yaml,yml}\"",
    "prebuild-ts": "pnpm -F @utrad-ical/circus-rs run prebuild",
    "build-ts": "tsc -b",
    "postbuild-ts": "pnpm -F @utrad-ical/circus-rs run postbuild",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@babel/core": "^7.18.9",
    "@babel/preset-env": "^7.18.9",
    "@babel/preset-typescript": "^7.18.6",
    "@eslint/compat": "^1.1.1",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.10.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^18.19.64",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-react-compiler": "^19.0.0-beta-a7bf2bd-20241110",
    "dotenv": "^16.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^28.8.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-compiler": "^19.0.0-beta-a7bf2bd-20241110",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "react-compiler-runtime": "^19.0.0-beta-a7bf2bd-20241110",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.4.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "avoid"
  },
  "jest": {
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.pnpm/[^/]+/node_modules/)?(@utrad-ical/circus-(rs|cs-core|lib)/src|mongodb/lib/runtime_adapters))"
    ],
    "setupFiles": [
      "dotenv/config"
    ],
    "testEnvironment": "node",
    "testTimeout": 10000,
    "maxWorkers": 1
  }
}
