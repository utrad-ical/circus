{
  "name": "@utrad-ical/circus-lib",
  "version": "0.17.0",
  "type": "module",
  "description": "Shared utilities for CIRCUS projects",
  "main": "dist/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config/loadConfig.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./config": {
        "types": "./dist/config/loadConfig.d.ts",
        "default": "./dist/config/loadConfig.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/utrad-ical/circus.git",
    "directory": "packages/circus-lib"
  },
  "author": "Soichiro Miki <smiki-tky@umin.ac.jp>",
  "license": "MIT",
  "dependencies": {
    "cosmiconfig": "^6.0.0",
    "fs-extra": "^9.0.0",
    "logform": "^2.2.0",
    "merge": "^1.2.1",
    "multi-integer-range": "^6.1.0",
    "tar-stream": "^2.1.0",
    "ulid": "^2.3.0",
    "winston": "^3.2.1",
    "winston-daily-rotate-file": "^4.4.1",
    "winston-transport": "^4.4.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^8.1.0",
    "@types/node": "^24.19.2",
    "@types/tar-stream": "^1.6.2",
    "tsdown": "0.23.7",
    "tslib": "^1.11.2",
    "typescript": "~6.0.3"
  },
  "files": [
    "dist"
  ]
}
