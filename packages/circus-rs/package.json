{
  "name": "@utrad-ical/circus-rs",
  "version": "0.27.0",
  "type": "module",
  "scripts": {
    "start": "node ./server.ts",
    "demo": "pnpm run \"/^demo:/\"",
    "demo:server": "node --watch server.ts",
    "demo:vite": "vite --config demo/vite.config.ts",
    "build": "node -e \"for (const d of process.argv.slice(1)) fs.rmSync(d, { recursive: true, force: true })\" dist && tsdown && node -e \"fs.copyFileSync('src/browser/circus-rs.css', 'dist/browser/circus-rs.css')\"",
    "clean": "node -e \"for (const d of process.argv.slice(1)) fs.rmSync(d, { recursive: true, force: true })\" dist",
    "typecheck": "tsc --noEmit && tsc -p demo/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/utrad-ical/circus.git",
    "directory": "packages/circus-rs"
  },
  "license": "MIT",
  "main": "dist/browser/index.js",
  "exports": {
    ".": "./src/browser/index.ts",
    "./server": "./src/server/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "./package.json": "./package.json",
      "./circus-rs.css": "./dist/browser/circus-rs.css"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "@utrad-ical/circus-lib": "workspace:*",
    "dicom-parser": "^1.8.4",
    "extend": "^3.0.2",
    "gl-matrix": "^2.4.0",
    "hono": "^4.13.19",
    "http-status": "^1.5.0",
    "jpeg-lossless-decoder-js": "^2.0.4",
    "lru-cache": "^11.0.0",
    "multi-integer-range": "^6.1.0",
    "pngjs": "^3.4.0",
    "tarn": "^3.0.1",
    "three": "^0.98.0",
    "tslib": "^1.11.2",
    "validator": "^7.0.0",
    "ws": "^8.8.0"
  },
  "devDependencies": {
    "@types/compression": "0.0.33",
    "@types/fs-extra": "^8.1.2",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^3.4.2",
    "@types/three": "^0.93.31",
    "@types/validator": "^6.3.0",
    "@types/ws": "^8.5.3",
    "@utrad-ical/circus-icons": "workspace:*",
    "fs-extra": "^11.2.0",
    "tsdown": "0.23.7",
    "typescript": "~7.0.2",
    "vite": "8.3.7"
  },
  "files": [
    "dist",
    "config/default.js"
  ]
}
