{
  "name": "@utrad-ical/circus-rs",
  "version": "0.27.0",
  "type": "module",
  "scripts": {
    "start": "node ./server.js",
    "debug": "nodemon --inspect ./server.js",
    "devserver": "webpack serve --mode=development --config webpack.config.cjs",
    "build": "rimraf dist && tsdown && lessc src/browser/circus-rs.less dist/browser/circus-rs.css && cp src/browser/circus-rs.less dist/browser/",
    "watch": "webpack --watch --config webpack.config.cjs",
    "clean": "rimraf dist dist-demo",
    "docs": "jekyll build --source=./docs --dest=./docs/_site && cp -r ./dist-demo ./docs/_site",
    "docserver": "jekyll serve --source=./docs --dest=./docs/_site",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/utrad-ical/circus.git",
    "directory": "packages/circus-rs"
  },
  "license": "MIT",
  "main": "dist/browser/index.js",
  "exports": {
    ".": "./src/browser/index.ts",
    "./server": "./src/server/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "./package.json": "./package.json",
      "./circus-rs.css": "./dist/browser/circus-rs.css"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@babel/core": "^7.18.9",
    "@babel/preset-env": "^7.18.9",
    "@babel/preset-typescript": "^7.18.6",
    "@utrad-ical/circus-icons": "workspace:*",
    "@utrad-ical/circus-lib": "workspace:*",
    "axios": "^1.7.7",
    "dicom-parser": "^1.8.4",
    "events": "^3.3.0",
    "extend": "^3.0.2",
    "gl-matrix": "^2.4.0",
    "http-status": "^1.5.0",
    "jpeg-lossless-decoder-js": "^2.0.4",
    "json5": "^0.5.1",
    "koa": "^2.11.0",
    "koa-compose": "^4.1.0",
    "koa-compress": "^2.0.0",
    "koa-json": "^2.0.2",
    "koa-mount": "^3.0.0",
    "koa-router": "^7.4.0",
    "lru-cache": "^11.0.0",
    "minimist": "^1.2.0",
    "multi-integer-range": "^6.1.0",
    "pngjs": "^3.4.0",
    "strict-event-emitter-types": "^2.0.0",
    "tarn": "^3.0.1",
    "three": "^0.98.0",
    "tinycolor2": "^1.4.1",
    "tslib": "^1.11.2",
    "validator": "^7.0.0",
    "winston": "^3.2.1",
    "ws": "^8.8.0"
  },
  "devDependencies": {
    "@types/compression": "0.0.33",
    "@types/fs-extra": "^8.1.2",
    "@types/http-status": "^0.2.30",
    "@types/koa": "^2.11.3",
    "@types/koa-compose": "^3.2.5",
    "@types/koa-compress": "^2.0.9",
    "@types/koa-json": "^2.0.18",
    "@types/koa-mount": "^3.0.1",
    "@types/koa-router": "^7.4.0",
    "@types/lru-cache": "^4.1.2",
    "@types/minimist": "^1.2.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^3.4.2",
    "@types/three": "^0.93.31",
    "@types/tinycolor2": "^1.4.0",
    "@types/validator": "^6.3.0",
    "@types/ws": "^8.5.3",
    "babel-loader": "^9.2.1",
    "benchmark": "^2.1.4",
    "css-loader": "^7.1.2",
    "file-loader": "^6.2.0",
    "fs-extra": "^11.2.0",
    "glob-promise": "^3.4.0",
    "less": "^3.11.1",
    "less-loader": "^10.0.1",
    "merge": "^1.2.1",
    "rimraf": "^5.0.10",
    "style-loader": "^4.0.0",
    "svgicons2svgfont": "^5.0.2",
    "tsdown": "0.23.7",
    "ttf2woff": "^2.0.1",
    "typescript": "~6.0.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "nodemonConfig": {
    "ext": "ts,js,json"
  },
  "files": [
    "dist",
    "config/default.js"
  ]
}
