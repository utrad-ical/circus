{
  "extends": "../../tsconfig.settings.json",
  "compilerOptions": {
    // Bundled by Vite (web-ui) and tsdown
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "es2022"],
    "jsx": "react"
  },
  "include": [
    "src/**/*",
    // Ambient declarations used by the circus-rs sources (e.g., `*?raw`)
    "../circus-rs/src/typings/ambient.d.ts",
    "../circus-rs/src/typings/gl-matrix/*.d.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
