{
  "extends": "../../tsconfig.settings.json",
  "compilerOptions": {
    // Bundled by webpack
    "module": "esnext",
    "moduleResolution": "bundler",
    // rb-components ships .tsx sources that do not follow this rule
    "verbatimModuleSyntax": false,
    "lib": ["dom", "webworker", "es2022"],
    "jsx": "react",
    // Mirrors webpack's `resolve.modules` (bare imports from src/)
    "paths": {
      "*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    // Ambient declarations used by the circus-rs sources (e.g., `*?raw`)
    "../circus-rs/src/typings/ambient.d.ts",
    "../circus-rs/src/typings/gl-matrix/*.d.ts"
  ]
}
