{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "declaration": true,
    "strict": true,
    "composite": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  }
}
