{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "strict": true,
    // Type checking only; publishable builds are made by tsdown
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "types": ["node"]
  }
}
